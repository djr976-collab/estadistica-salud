# ─── IA (opcional). Sin esta clave la app funciona en MODO DEMO con corrección local ───
ANTHROPIC_API_KEY=
# Modelo usado por el servidor (por defecto claude-opus-5-5). Para abaratar: claude-haiku-5-5
AI_MODEL=claude-opus-5-5
# Control de costos
AI_DAILY_LIMIT=300          # llamadas totales por día (por instancia del servidor)
AI_RATE_LIMIT_PER_IP=20     # llamadas por IP cada 10 minutos
AI_MAX_ANSWER_CHARS=1200    # largo máximo de respuesta del estudiante enviada a la IA
AI_USER_DAILY_LIMIT=40      # con cuentas: llamadas de IA por usuario por día

# ─── Panel docente en modo DEMO (sin Supabase). PIN sólo para pruebas: NO es seguridad real ───
NEXT_PUBLIC_DEMO_ADMIN_PIN=1234
# Permite que exista el modo "sin filtro" (el docente puede apagarlo igual desde el panel)
NEXT_PUBLIC_ALLOW_SPICY=true

# ─── Cuentas de usuario (Supabase). Vacío = modo demo sin cuentas ───
# Supabase → Project Settings → API: "Project URL" y la clave pública "anon"/"publishable".
# NO hace falta (ni conviene) cargar la service_role key: la app funciona sólo con la clave pública + RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

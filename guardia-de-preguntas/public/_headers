# Encabezados para Netlify (también funcionan con Netlify Drop).
# El Service Worker y la página se revalidan siempre: así los celulares
# detectan cada versión nueva. Los recursos con hash se guardan un año.
/sw.js
  Cache-Control: no-cache
/offline-manifest.json
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/assets/*
  Cache-Control: public, max-age=31536000, immutable

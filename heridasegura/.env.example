# =============================================================
# HeridaSegura IA — variables de entorno (EJEMPLO, sin credenciales)
# Copie a .env.local (desarrollo) o configure en Netlify > Site settings > Environment.
# =============================================================

# URL del proyecto Supabase y clave pública (anon/publishable). La clave anon es
# pública por diseño: la seguridad la garantizan las políticas RLS.
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-clave-anon-publica

# Clave de servicio: SOLO servidor (rutas /api). NUNCA prefijar con NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Modo demostración local (sin Supabase, datos ficticios en el navegador).
# "true" fuerza el modo demo aunque existan variables de Supabase.
NEXT_PUBLIC_DEMO_MODE=false
